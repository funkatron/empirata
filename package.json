{
  "name": "empirata-rules-lab",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Empirata: strict classic Empire DOS Interstel 2.05 rules laboratory",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run test:coverage",
    "start": "node scripts/server.mjs",
    "dev": "npm run build && npm run start",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-coverage-include='dist/engine/*.js' --test-coverage-lines=85 --test-coverage-branches=80 tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
