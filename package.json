{
  "name": "empirata-rules-lab",
  "version": "0.6.18",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Empirata: strict classic Empire DOS Interstel 2.05 rules laboratory",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run test:coverage",
    "test:observer": "npm run build && node --test smoke/observer.mjs",
    "test:map-paint-timing": "npm run build && node --test smoke/map-paint-timing.mjs",
    "evaluate:ai": "npm run build && node scripts/evaluate-ai.mjs",
    "evaluate:held-out-capture": "npm run build && node scripts/held-out-capture-eval.mjs",
    "start": "node scripts/server.mjs",
    "dev": "npm run build && npm run start",
    "lint": "eslint src/",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-coverage-include='dist/engine/**/*.js' --test-coverage-lines=85 --test-coverage-branches=80 tests/*.test.mjs"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0"
  }
}
